<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\WirelessADBManagerIcon.png" />
    <None Remove="Resources\WirelessADBManager_Device_Icon.png" />
    <None Remove="Resources\WirelessADBManager_USB_Device_Icon.png" />
    <None Remove="WirelessADBManagerToolWindowContent.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AdvancedSharpAdbClient" Version="3.6.16" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="QRCoder.Xaml" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Views\ManualPairingCodePromptView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <EmbeddedResource Update="WirelessADBManagerToolWindowContent.xaml" LogicalName="WirelessADBManagerVSExtension.WirelessADBManagerToolWindowContent.xaml" />
    <Page Remove="WirelessADBManagerToolWindowContent.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\WirelessADBManagerIcon.png" />
    <Content Include="Resources\WirelessADBManager_Device_Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\WirelessADBManager_USB_Device_Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WirelessADBManagerToolWindowContent.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The VS Extensibility SDK source generator only emits Microsoft.VisualStudio.Community
    installation targets. This inline task clones those entries for Professional and Enterprise
    so the VSIX is accepted by all three SKUs.
  -->
  <UsingTask TaskName="AddVsInstallationTargets"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Xml.Linq" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          XNamespace ns = "http://schemas.microsoft.com/developer/vsx-schema/2011";
          var doc = XDocument.Load(ManifestPath);
          var installation = doc.Root.Element(ns + "Installation");
          var existing = installation.Elements(ns + "InstallationTarget").ToList();
          var existingIds = existing.Select(e => (string)e.Attribute("Id")).Distinct().ToList();
          foreach (var id in new[] { "Microsoft.VisualStudio.Pro", "Microsoft.VisualStudio.Enterprise" })
          {
              if (!existingIds.Contains(id))
              {
                  foreach (var template in existing)
                  {
                      var clone = new XElement(template);
                      clone.SetAttributeValue("Id", id);
                      installation.Add(clone);
                  }
              }
          }
          doc.Save(ManifestPath);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="_AddVsEditionsToManifest" AfterTargets="CoreCompile"
          Condition="Exists('$(IntermediateOutputPath)extension.vsixmanifest')">
    <AddVsInstallationTargets ManifestPath="$(IntermediateOutputPath)extension.vsixmanifest" />
  </Target>

</Project>
